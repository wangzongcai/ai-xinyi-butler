# Edge Functions 环境变量模板
# 部署到 Supabase 后，平台会自动注入 SUPABASE_URL / SUPABASE_PUBLISHABLE_KEYS /
# SUPABASE_SECRET_KEYS / SUPABASE_JWKS，无需手动配置，也不要把真实 Key 提交到仓库。
#
# 只有在本机自托管或非 Supabase 环境运行时，才需要复制本文件为 .env.local 并填写真实值：
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS={"keys":[]}

# AI 大模型密钥（M7/M8）：generate-blessings / generate-gifts 用 DeepSeek。
# 部署到 Supabase 远程后用 `supabase secrets set DEEPSEEK_API_KEY=<key>` 设置，
# 不要把真实 Key 提交到仓库。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 贺卡背景图（M9）：generate-card-image 用火山引擎方舟 Seedream 5.0 flash。
# 部署到 Supabase 远程后用 `supabase secrets set ARK_API_KEY=<key>` 设置。
ARK_API_KEY=ark-xxxxxxxxxxxxxxxx
